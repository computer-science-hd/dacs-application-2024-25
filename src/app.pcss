/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

table th:first-child{
  border-radius:8px 0 0 8px;
}

table th:last-child{
  border-radius:0 8px 8px 0;
}

/* to preserve bullets etc. */

ul {
  list-style-type: disc;
  padding-left: 1.5rem;
}

ol {
  list-style-type: decimal;
  padding-left: 1.5rem;
}
